# Database Configuration
# Supabase PostgreSQL connection string matching Prisma URL configurations
DATABASE_URL="postgresql://username:password@host:port/dbname?schema=public"

# AI Inference Providers
# Groq cloud API Key for Llama-3 parsing endpoints
GROQ_API_KEY="gsk_..."

# Vector Embeddings Provider
# Voyage AI API Key for voyage-3 1024 float vectors
VOYAGE_API_KEY="pa-..."

# NextAuth Authentication Config
# Secret key used to sign NextAuth session JWT tokens
NEXTAUTH_SECRET="agentos-session-secret-mvp-12345"
# Live URL of Next.js deployment hosting the workspace application
NEXTAUTH_URL="http://localhost:3000"

# Google Integration (OAuth2 Web Client Credentials)
GOOGLE_CLIENT_ID="597419749703-..."
GOOGLE_CLIENT_SECRET="GOCSPX-..."
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
